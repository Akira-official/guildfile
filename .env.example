# ==========================================
# HelixCore Configuration Template
# ==========================================

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_target_guild_id_here
DISCORD_APPLICATION_ID=your_application_client_id_here

# Groq Cloud API Credentials (Ultra-Low Latency LLM)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen-2.5-32b

# Optional: Fallback LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Bot Behavior & Tuning
DEFAULT_ACTIVE_CHANNEL=💬・general-chat
TYPING_BURST_MIN_DELAY=0.8
TYPING_BURST_MAX_DELAY=1.8
AUTO_REACT_CHANCE=0.25
TYPO_CORRECTION_CHANCE=0.08
MEMORY_DB_PATH=helix_memory.db

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

